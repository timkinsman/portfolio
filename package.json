{
  "name": "portfolio",
  "private": true,
  "version": "0.18.2",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext js,ts,tsx .",
    "lint:fix": "eslint --ext js,ts,tsx . --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*.+(js|json|ts|tsx)\"",
    "format": "npm run prettier -- --write",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@lukehagar/plexjs": "^0.32.3",
    "@nayhoo/hooks": "^0.2.4",
    "@nayhoo/ui": "^0.20.1",
    "@nayhoo/utils": "^0.2.2",
    "@next/third-parties": "^15.1.6",
    "@t3-oss/env-nextjs": "^0.11.1",
    "axios": "^1.17.0",
    "next": "^15.5.19",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-query": "^3.39.3",
    "react-router": "^6.30.4",
    "react-router-dom": "6.0.0-beta.0",
    "reading-duration": "^1.1.2",
    "sugar-high": "^0.9.3",
    "type-fest": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nayhoo/eslint-config": "^1.0.5",
    "@nayhoo/prettier-config": "^1.0.4",
    "@nayhoo/tsconfig": "^1.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "20.19.39",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vanilla-extract/next-plugin": "^2.4.9",
    "eslint": "~9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.1",
    "typescript": "5.6.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml,graphql}": [
      "prettier --write"
    ]
  }
}
